gerador = function(numero){
vetor <- runif(numero, 0, 1)
media <- mean(vetor)
### Normalização do resultado
resultado <- (abs(numero) * media)
return(resultado)
}
gerador = function(numero){
vetor <- runif(numero, 0, 1)
media <- mean(vetor)
### Normalização do resultado
resultado <- (abs(numero) * media)
return(resultado)
}
