gerador = function(numero){
vetor <- runif(numero, 0, 1)
return(vetor)
}
gerador(6)
gerador(1)
fracasso <- 0
sucesso <- 0
valores <- c()
for (i in 1:100000) {
lancamento <- sample(1:6, size=100000, replace=TRUE)
if(fracasso == 2) {
break
}
if(lancamento == 6){
fracasso = fracasso + 1
} else {
sucesso = sucesso + 1
valores[i] = gerador(1)
}
}
estimativa_media_monte_carlo_sucessos <- mean(valores)
estimativa_media_monte_carlo_sucessos
