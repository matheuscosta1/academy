jogos <- c()
contador_juju <- 0
contador_jorel <- 0
dinheiro_juju = 18
dinheiro_jorel = 7
for (i in 1:100000) {
if(dinheiro_juju == 0 || dinheiro_jorel == 0) {
break
}
moeda <- sample(0:1, size = 1)
if(moeda == 0){
jogos[i] <- "Juju"
dinheiro_jorel = dinheiro_jorel - 1
}
else{
jogos[i] <- "Jorel"
dinheiro_juju = dinheiro_juju - 1
}
}
estimativa <- mean(jogos == "Juju")
estimativa
jogos
